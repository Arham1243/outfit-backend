APP_NAME="WMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wms
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
CACHE_PREFIX=

SESSION_DRIVER=cookie
SANCTUM_STATEFUL_DOMAINS=${FRONTEND_URL}

SUPPORT_EMAIL=support@servicore.io

QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=
QUICKBOOKS_ENVIRONMENT=

OTP_FALLBACK_ENABLED=false
OTP_FALLBACK_CODE=083078

CRON_API_TOKEN=your-long-random-secret-here

HF_API_TOKEN=
HF_IMAGE_CLASSIFICATION_URL=https://router.huggingface.co/hf-inference/models/google/vit-base-patch16-224

OUTFIT_GENERATION_PROVIDER=fashn
OUTFIT_MAX_COMBINATIONS=2
OUTFIT_DEDUPE_DAYS=30

FASHN_ENABLED=true
FASHN_API_KEY=
FASHN_BASE_URL=https://api.fashn.ai
FASHN_MAX_COMBINATIONS=2
FASHN_MAX_ATTEMPTS=2
FASHN_POLL_INTERVAL_SECONDS=3
FASHN_POLL_TIMEOUT_SECONDS=600
FASHN_GENERATION_MODE=fast
FASHN_RESOLUTION=1k
FASHN_DEDUPE_DAYS=30
FASHN_BASE_MODEL_CACHE_VERSION=v3-generic
FASHN_MODEL_CREATE_MODE=balanced
FASHN_MODEL_CREATE_ASPECT_RATIO=2:3
FASHN_MODEL_CREATE_RESOLUTION=2k

OPENAI_OUTFIT_ENABLED=true
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_COMBINATION_MODEL=gpt-5.1
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1024x1536
OPENAI_IMAGE_QUALITY=high
OPENAI_STUDIO_REFERENCE_PATH=assets/images/studio_template.jpg
OPENAI_BASE_MODEL_CACHE_VERSION=v1
